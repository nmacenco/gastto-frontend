{
  "name": "gastto-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "next dev",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm validate:messages && node scripts/remove-message-declarations.mjs && next build --webpack",
    "validate:messages": "node scripts/validate-messages.mjs",
    "test:e2e": "playwright test",
    "test:performance": "PERFORMANCE_TEST=1 playwright test e2e/performance.spec.ts --project=chromium"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core"
    ]
  },
  "dependencies": {
    "next": "16.3.3",
    "next-intl": "4.13.4",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@formatjs/icu-messageformat-parser": "3.5.17",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.3",
    "jsdom": "30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
